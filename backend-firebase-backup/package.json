{
  "name": "bike-rental-firebase-backend",
  "version": "0.1.0",
  "private": true,
  "description": "Stage C1 Firebase foundation for the motorbike rental system",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/src/server.js",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "test:emulator": "npm run build && firebase emulators:exec --only firestore \"node --test dist/tests/*.test.js\"",
    "emulators": "firebase emulators:start --only firestore"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^5.1.0",
    "firebase-admin": "^13.6.0"
  },
  "devDependencies": {
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.3",
    "@types/node": "^24.10.1",
    "firebase-tools": "^14.19.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
